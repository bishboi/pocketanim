.venv/
__pycache__/
*.pyc

# Manim render output
media/
corpus/renders/

# The tier-1 artefacts are versioned, not ignored. They are what ships -- the
# whole corpus is ~1.9 MB, dominated by baked geometry that is content rather
# than build output -- and CI cannot check that the implementations agree
# unless it has something to check them against. Regenerate with:
#   python -m dsl.export_dsl corpus/scenes/<file> <Class> --write

# Sampled IR exports: 20 MB of tier-3 fallbacks, regenerable from corpus/scenes
# and far too large to version. CI checks the decoders against the baked assets
# in dsl/generated/assets instead, which exercise the same container.
corpus/ir/

# Player build output and its downloaded toolchain
player/build/

# Kokoro weights and generated narration
harness/models/
harness/app/.voice/

# Scene library packed into the apps at build time
player/benchmark/src/main/assets/
player/app/src/main/assets/

# Gradle's own state and per-module outputs. The last commit shipped ~220 of
# these; they are machine-local and change on every build.
.gradle/
player/*/build/
.kotlin/

# The harness app's install and build
harness/app/node_modules/
harness/app/.next/

# Lecture Forge working folders: jobs and the content-hash cache
harness/forge/jobs/
harness/forge/cache/

# Geocoded place names, cached per machine
harness/lecture/.cache/
# Manim LaTeX/text renders shared by every build (scripts/export_scene.py manim_cache)
harness/.cache/
harness/lecture/data/geonames/
harness/lecture/data/icons/
harness/lecture/data/illustrations/
harness/lecture/data/bioicons/
harness/lecture/data/drawlib/
harness/lecture/data/historical/

# Narration and sound effects made by a lecture run without PANIM_AUDIO_DIR
build_audio/

# iOS player build output (SwiftPM, XcodeGen, Xcode) and local secrets
ios/.build*/
ios/*.xcodeproj/
ios/App/Secrets.xcconfig
ios/DerivedData/
# The scene library packed into the iOS app at build time (as player/app/src/main/assets), and the
# Info.plist XcodeGen writes from project.yml
ios/App/Resources/library/
ios/App/Info.plist
ios/build/
.venv3/
harness_v3/.cache/
harness_v3/out/
