# Generation. Without a key the harness uses an offline fixture provider that
# returns real, exportable Manim -- enough to exercise export, preview and the
# edit loop with no network.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-6-astra
# The model that draws every picture and the book's figures as SVG (empty: OPENROUTER_MODEL). Pick one that reads
# images: it is shown each drawing as the board renders it and fixes what it sees. The page can override it.
OPENROUTER_SVG_MODEL=
# How many look-and-fix rounds each drawing gets (0 turns the review off; each round is one more model call).
# PANIM_SVG_REVIEWS=1

# Speed. Most of a run is the model writing. The transcript is plain teacher's talk: a fast model writes it well
# (the page can override it), and the stronger OPENROUTER_MODEL is kept for the script and its repairs.
# OPENROUTER_TRANSCRIPT_MODEL=google/gemini-3.8-flash
# How hard the model thinks before writing: minimal is fastest; low is the default.
# PANIM_REASONING_EFFORT=low
# How long the script writer waits for the book's figures to be drawn (seconds from when drawing starts). Figures
# not ready by then are built in Manim this run; their drawings are kept for the next. 0: never wait.
# PANIM_FIGURE_WAIT_SECONDS=120
# Sections written at once (transcript and chapters; at most 8).
# PANIM_TRANSCRIPT_PARALLEL=6

# Persistence. Without these the pipeline still runs; nothing is written down.
# Schema: harness/supabase/migrations (apply with harness/scripts/apply-schema.sh).
# Save needs the service role key: it writes the tables and the `lectures` bucket. The phone app uses the anon key.
NEXT_PUBLIC_SUPABASE_URL=https://wasvdathkolvobmknkev.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Whose saved lectures are (created on first save), or a Supabase auth user id in PANIM_OWNER_ID.
# PANIM_OWNER_EMAIL=harness@pocketanim.local

# Only needed if the repo venv is missing; the bridge prefers ../../.venv/bin/python.
PYTHON=

# Optional: clean PDF conversion with figures (https://www.datalab.to). Without it pypdf is used.
DATALAB_API_KEY=
