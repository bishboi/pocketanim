{
  "panel":     {"doc": "Clear the side panel and head it.", "required": {"title": "str"}, "optional": {"sub": "str"}},
  "fact":      {"doc": "A bulleted line in the panel (under 90 characters).", "required": {"text": "str"}, "optional": {"tone": "tone"}},
  "stat":      {"doc": "A big number with a label.", "required": {"value": "str", "label": "str"}, "optional": {"tone": "tone"}},
  "bars":      {"doc": "A bar chart in the panel, at most 6 bars.", "required": {"items": "items"}, "optional": {"unit": "str", "tone": "tone"}},
  "compare":   {"doc": "Two numbers side by side.", "required": {"left": "pair", "right": "pair"}, "optional": {"left_tone": "tone", "right_tone": "tone"}},
  "timeline":  {"doc": "A time line in the panel: [[date, label], ...], at most 6.", "required": {"events": "items"}, "optional": {"tone": "tone"}},
  "network":   {"doc": "People and alliances: nodes and edges.", "required": {"nodes": "list"}, "optional": {"edges": "list", "tone": "tone"}},
  "clear":     {"doc": "Empty the panel.", "required": {}, "optional": {}},
  "marker":    {"doc": "A labelled dot at a place, anchor or [lon, lat].", "map": true, "required": {"place": "place"}, "optional": {"label": "str", "tone": "tone", "side": "side"}},
  "river":     {"doc": "A Natural Earth river by English name.", "map": true, "required": {"name": "str"}, "optional": {"tone": "tone"}},
  "path":      {"doc": "A hand-drawn line: a region feature name or [[lon, lat], ...].", "map": true, "required": {"points": "places"}, "optional": {"tone": "tone"}},
  "route":     {"doc": "A curved arrow through places, with optional dated waypoint labels.", "map": true, "required": {"points": "places"}, "optional": {"labels": "list", "tone": "tone"}},
  "state":     {"doc": "Fill one state or province.", "map": true, "required": {"name": "str"}, "optional": {"tone": "tone", "opacity": "num"}},
  "dim":       {"doc": "Fade filled areas down before highlighting one.", "map": true, "required": {}, "optional": {"opacity": "num"}},
  "graticule": {"doc": "A dashed parallel (lat) or meridian (lon).", "map": true, "required": {}, "optional": {"lat": "num", "lon": "num", "label": "str", "tone": "tone"}},
  "unit":      {"doc": "Place a unit counter.", "map": true, "required": {"id": "str"}, "optional": {"at": "place", "label": "str", "side": "tone", "kind": "kind", "strength": "str"}},
  "move":      {"doc": "Move a unit to a place.", "map": true, "required": {"unit": "unit", "to": "place"}, "optional": {}},
  "charge":    {"doc": "A unit charges a place or unit.", "map": true, "required": {"unit": "unit", "to": "place"}, "optional": {}},
  "rout":      {"doc": "A unit breaks and falls back.", "map": true, "required": {"unit": "unit"}, "optional": {"to": "place"}},
  "volley":    {"doc": "A unit fires at a unit or place.", "map": true, "required": {"from": "unit"}, "optional": {"to": "place", "tone": "tone"}},
  "clock":     {"doc": "Turn the battle clock to HH:MM.", "map": true, "required": {"time": "time"}, "optional": {}},
  "highlight": {"doc": "Draw the eye to a unit or place.", "map": true, "required": {"target": "place"}, "optional": {}}
}
