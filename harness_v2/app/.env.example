# Copy to .env.local (not versioned). Anything not set here is taken from v1's harness/app/.env.local, and v1's
# variable names work too (OPENROUTER_MODEL, OPENROUTER_FIGURE_MODEL, PANIM_IMAGE_MODEL, PANIM_MANIM_MODEL...).
# The page starts every run with these; a run's own can still be changed on the page.

OPENROUTER_API_KEY=
DATALAB_API_KEY=
# DATALAB_MODE=balanced

# Transcript
# V2_PLANNER_MODEL=anthropic/claude-sonnet-4.5     # divides the book into lectures, maps goals
# V2_WRITER_MODEL=anthropic/claude-sonnet-4.5      # writes the lectures
# V2_FIGURE_MODEL=google/gemini-2.5-flash          # reads images: describes the figures

# Figure triage
# V2_TRIAGE_MODEL=google/gemini-2.5-flash          # reads images: decides how each figure is shown
# V2_TRIAGE_PARALLEL=4

# The figures' builders (steps to come)
# V2_IMAGE_MODEL=google/gemini-2.5-flash-image     # makes images: redraws figures triaged Exact or Styled
# V2_SVG_MODEL=anthropic/claude-sonnet-4.5         # writes SVG drawings
# V2_MANIM_MODEL=anthropic/claude-sonnet-4.5       # writes Manim code
# V2_MAP_MODEL=anthropic/claude-sonnet-4.5         # finds a map's places
