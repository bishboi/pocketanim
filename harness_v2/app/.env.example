# Copy to .env.local (not versioned). Anything not set here is taken from v1's harness/app/.env.local, and v1's
# variable names work too (OPENROUTER_MODEL, OPENROUTER_FIGURE_MODEL, PANIM_IMAGE_MODEL, PANIM_MANIM_MODEL...).
# The page starts every run with these; a run's own can still be changed on the page.

OPENROUTER_API_KEY=
DATALAB_API_KEY=
# DATALAB_MODE=balanced

# Transcript
# V2_WRITER_MODEL=anthropic/claude-sonnet-4.5      # writes each lecture as its chapters and beats, in one call
# V2_MAX_LECTURES=40                               # at most this many lectures a book
# V2_FIGURE_MODEL=google/gemini-2.5-flash          # reads images: describes the figures

# Figure triage
# V2_TRIAGE_MODEL=typesafe/jev-1.14                # a decision model (Decisions API): how each figure is shown
# V2_TRIAGE_CONFIDENCE=0.6                         # under this confidence a figure is marked unsure
# V2_TRIAGE_CHAT_MODEL=google/gemini-2.5-flash     # reads images: asked about the unsure figures (with how and why)
# V2_TRIAGE_PARALLEL=4

# The figures' builders (steps to come)
# V2_IMAGE_MODEL=google/gemini-2.5-flash-image     # makes images: redraws figures triaged Exact or Styled
# V2_REDRAW_BACKGROUND=#0D1117                     # what a redrawn figure stands on (v1's default board colour)
# V2_GENERATE_PARALLEL=3
# V2_MAP_REDRAW_MARGIN=0.2                         # a Map choice this close to a redraw is redrawn instead
# V2_SVG_MODEL=anthropic/claude-sonnet-4.5         # reads a figure and writes its SVG drawing, in one call
# V2_MANIM_MODEL=anthropic/claude-sonnet-4.5       # reads a figure and writes its Manim code, in one call
# V2_PYTHON=../../.venv/bin/python                 # the Python with Manim (default: the repo's .venv)
# V2_MANIM_TIMEOUT_SECONDS=120
# V2_MAP_MODEL=anthropic/claude-sonnet-4.5         # reads a book's map and writes its map script, in one call
# V2_ENGINE=../engine                              # v2's lecture engine (default: harness_v2/engine)
# V2_SCENES_MODEL=anthropic/claude-sonnet-4.5      # writes each beat's visuals as the engine's operations
# V2_SCENES_PARALLEL=3                             # lectures built at once
# V2_RENDER_PARALLEL=2                             # beat and chapter renders at once (Manim, CPU heavy)
# V2_COMPILE_TIMEOUT_SECONDS=900                   # a lecture's compile (its AI pictures are made then)
# V2_MANIM_AGENT_TURNS=10                          # the Manim agent's turns on one beat's figure
# V2_MANIM_AGENT_IMAGES=4                          # pictures it may make for one figure

# Voice (the Voice tab: chapters spoken and their animations timed to the words)
# GEMINI_API_KEY=                                  # Gemini TTS (the default voice when set); else espeak-ng, offline
# ELEVENLABS_API_KEY=                              # ElevenLabs (times its own words)
# GOOGLE_TTS_API_KEY=                              # Google Chirp 3 HD
# V2_TIMING_MODEL=google/gemini-2.5-flash          # times each beat's animations to its words
# V2_AUDIO_DIR=.data/voice                         # every line spoken, kept by voice and words
# V2_VOICE_TIMEOUT_SECONDS=1800
# PANIM_ALIGN_WHISPER=tiny                         # the local word aligner (faster-whisper); downloaded on first use
