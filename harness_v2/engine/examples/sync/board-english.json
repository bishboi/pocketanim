      {
       "op": "reveal",
       "diagram": "chain",
       "nodes": [
        "trade"
       ],
       "on": "Craftsmen"
      },
      {
       "op": "focus",
       "diagram": "chain",
       "node": "crafts",
       "on": "traders"
      }
     ]
    }
   ]
  },
  {
