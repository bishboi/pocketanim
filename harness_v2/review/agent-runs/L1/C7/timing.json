, "end": 105.616}, {"w": "policies", "start": 105.616, "end": 106.216}, {"w": "से", "start": 106.216, "end": 106.456}, {"w": "टकराती", "start": 106.456, "end": 106.856}, {"w": "थी।", "start": 106.856, "end": 107.096}]}, {"n": 18, "text": "देश आर्थिक रूप से आगे बढ़ा और colonial empire बना, लेकिन इस empire ने घर में democracy के फैलाव को दबाया और उपनिवेशों के लोगों से टकराव बढ़ाया।", "start": 107.388, "end": 118.089, "words": [{"w": "देश", "start": 107.388, "end": 107.868}, {"w": "आर्थिक", "start": 108.808, "end": 109.208}, {"w": "रूप", "start": 109.208, "end": 109.468}, {"w": "से", "start": 109.468, "end": 109.728}, {"w": "आगे", "start": 109.728, "end": 110.008}, {"w": "बढ़ा", "start": 110.008, "end": 110.148}, {"w": "और", "start": 110.148, "end": 110.428}, {"w": "colonial", "start": 110.428, "end": 111.108}, {"w": "empire", "start": 111.108, "end": 111.528}, {"w": "बना", "start": 111.528, "end": 111.748}, {"w": "लेकिन", "start": 112.488, "end": 112.968}, {"w": "इस", "start": 112.968, "end": 113.208}, {"w": "empire", "start": 113.208, "end": 113.468}, {"w": "ने", "start": 113.468, "end": 113.728}, {"w": "घर", "start": 113.728, "end": 114.008}, {"w": "में", "start": 114.008, "end": 114.168}, {"w": "democracy", "start": 114.168, "end": 114.568}, {"w": "के", "start": 114.568, "end": 114.808}, {"w": "फैलाव", "start": 114.808, "end": 115.148}, {"w": "को", "start": 115.148, "end": 115.248}, {"w": "दबाया", "start": 115.248, "end": 115.728}, {"w": "और", "start": 115.728, "end": 116.048}, {"w": "उपनिवेशों", "start": 116.048, "end": 116.708}, {"w": "के", "start": 116.708, "end": 116.768}, {"w": "लोगों", "start": 116.768, "end": 117.028}, {"w": "से", "start": 117.028, "end": 117.168}, {"w": "टकराव", "start": 117.168, "end": 117.568}, {"w": "बढ़ाया।", "start": 117.568, "end": 117.928}]}, {"n": 19, "text": "तो आज के सवाल का जवाब यह है: Japan ने तेजी से बदलाव इसलिए किया क्योंकि उसके पास पहले से व्यापार, शहर और पढ़ाई की तैयारी थी, और नई government ने उन्हें nation-building में लगाय