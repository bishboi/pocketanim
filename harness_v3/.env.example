# Copy to harness_v3/.env.local (git-ignored) and fill in. The environment wins over this file; harness_v2/app/.env.local
# is read too, after it, so keys v2 already has need not be copied.
OPENROUTER_API_KEY=
DATALAB_API_KEY=
GEMINI_API_KEY=           # Google's Gemini TTS speaks the narration (the default voice when set; else offline Piper)
# V3_TTS_MODEL=gemini-3.8-flash-lite-tts   or gemini-3.8-flash-tts (fuller)
# V3_TTS_VOICE=Kore         the default Gemini voice (Zephyr, Puck, Charon, Kore, Fenrir, Leda, Orus, Aoede, ...)
# V3_TTS_STYLE=             how it is said (blank: the language's own: a warm narrator; Hinglish: a friendly Indian explainer)
# V3_TTS_JOBS=4             lines spoken at once
# V3_MODEL=anthropic/claude-haiku-4.5       the default model (any OpenRouter id; also typed in the app)
# A model per step (blank: V3_MODEL). The score step places and moves everything: it gains most from a strong model.
# V3_MODEL_SCRIPT=          the book's script (pages -> videos)
# V3_MODEL_STORYBOARD=
# V3_MODEL_SCORE=
# V3_MODEL_VISION=          the critic (sees frames)
# V3_IMAGE_MODEL=google/gemini-2.5-flash-image   pictures (photos, backdrops, portraits), through OpenRouter's Image API
# V3_IMAGE_MODEL_SMALL=     small things: cut-out objects and icons (pic), made six to a sheet (blank: V3_IMAGE_MODEL)
# V3_IMAGE_MODEL_LABELED=   pictures whose parts are labelled (`labels ... on PIC`): each part must show (blank: V3_IMAGE_MODEL)
# V3_IMAGE_SEARCH=0         1: pictures asked for from Wikimedia Commons (`photo commons "..."`) are searched for;
#                           0 (the default): they are made by the image model from the same words
# V3_IMAGE_QUALITY=medium   low | medium | high
# V3_LAYOUT_FIX=2           after the pictures, shots whose things cover each other, run off the screen or are empty go
#                           back to the score's model with the real sizes (rounds; 0: only checked and said)
# V3_LAYOUT_SHOTS=40        at most this many shots fixed a round
# V3_ICONS=0                0: no line icons; an `icon NAME` is drawn as a small hand-drawn picture (1: icons back)
# V3_SMALL_STYLE=           the style small pictures are drawn in (default: hand-drawn sketchbook doodles, people as
#                           simple stick-like figures), each cut out on a paper edge
# V3_SOUND=1                small sounds where things happen (0: none); a score's `sound off` too
# V3_MUSIC=calm             the music bed under the voice: calm, warm, tense, or none; a score's `music NAME` wins
# V3_TEXTURE=1              line boil, pen-drawn lines, paper grain and a vignette (0: off); a score's `texture off`
# V3_PARALLAX=1             layers slide at their own speeds as the camera travels between shots (0: off)
# V3_MOTION=paper           paper: cut-outs slapped down and peeled off, moves that overshoot and settle; plain: fades
# V3_CAPTIONS=0             1: the narration's words along the bottom, the one said lit; a score's `captions on`
# V3_IMAGE_JOBS=4           pictures made at once
# V3_IMAGE_SHEET=6          small objects (pic) asked for on one sheet and cut apart (1: one call each)
# V3_IMAGE_REFINE=1         the score's model rewrites each picture's words into an exact prompt first (0: off)
# V3_RENDER_MP4=0          1: also render each run's MP4 with Manim (slow; the Player needs none)
# V3_LOOK=editorial         editorial (paper, cards, pictures) or paper (line icons)
# V3_MODELS=openai/gpt-4.1-mini,google/gemini-2.5-flash    more models to suggest in the app
# V3_REASONING=low      how hard a reasoning model thinks: minimal|low|medium|high, or none
# DATALAB_MODE=balanced
# V3_PARALLEL=1         videos made at once (each one's render already uses several cores)
# V3_RENDER_JOBS=4      chunks of one video rendered at once (default: half the cores, at most 8)
# V3_SCORE_JOBS=6       shot calls in flight at once while scoring
