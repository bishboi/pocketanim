# Copy to harness_v3/.env.local (git-ignored) and fill in. The environment wins over this file; harness_v2/app/.env.local
# is read too, after it, so keys v2 already has need not be copied.
OPENROUTER_API_KEY=
DATALAB_API_KEY=
# V3_MODEL=anthropic/claude-haiku-4.5       the default model (any OpenRouter id; also typed in the app)
# A model per step (blank: V3_MODEL). The score step places and moves everything: it gains most from a strong model.
# V3_MODEL_SCRIPT=          the book's script (pages -> videos)
# V3_MODEL_STORYBOARD=
# V3_MODEL_SCORE=
# V3_MODEL_VISION=          the critic (sees frames)
# V3_IMAGE_MODEL=google/gemini-2.5-flash-image   pictures (pic, photo), through OpenRouter's Image API
# V3_IMAGE_QUALITY=medium   low | medium | high
# V3_IMAGE_JOBS=4           pictures made at once
# V3_IMAGE_SHEET=6          small objects (pic) asked for on one sheet and cut apart (1: one call each)
# V3_IMAGE_REFINE=1         the score's model rewrites each picture's words into an exact prompt first (0: off)
# V3_RENDER_MP4=0          1: also render each run's MP4 with Manim (slow; the Player needs none)
# V3_LOOK=editorial         editorial (paper, cards, pictures) or paper (line icons)
# V3_MODELS=openai/gpt-4.1-mini,google/gemini-2.5-flash    more models to suggest in the app
# V3_REASONING=low      how hard a reasoning model thinks: minimal|low|medium|high, or none
# DATALAB_MODE=balanced
# V3_PARALLEL=1         videos made at once (each one's render already uses several cores)
# V3_RENDER_JOBS=4      chunks of one video rendered at once (default: half the cores, at most 8)
# V3_SCORE_JOBS=6       shot calls in flight at once while scoring
