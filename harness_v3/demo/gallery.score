# The kit's gallery: every bigger piece and every mark, one shot each, timed in seconds. Baked to stills to check
# that each one draws (python engine/timeline.py demo/gallery.score RUN OUT; RUN holds any words.json).
look editorial

# ---- timeline: years, events kept clear of each other, a span, a marker moved to a year
shot years at 0,0
ent head1  label "timeline · event · span" size 0.18 at -4.8,3.4
ent tl     timeline 1000 1400 w 12 at 0,-0.6
ent e1     event 1066 "the conquest" on tl
ent e2     event 1086 "domesday book" on tl
ent e3     event 1215 "magna carta" on tl
ent e4     event 1347 "black death" on tl
ent e5     event 1381 "peasants' revolt" on tl
ent fam    span 1315 1317 "famine" on tl side down color coral
ent here   icon map-pin size 0.55 color coral at tl.1000
t0         cam years
t0.2       in head1 fade
t0.3-t1.3  in tl draw
t1.4       in e1 drop
t1.8       in e2 drop
t2.2       in e3 drop
t2.6       in e4 drop
t3.0       in e5 drop
t3.4       in fam fade
t3.6       in here pop
t3.8-t5    move here to tl.1347

# ---- charts: a line from real values, bars, a donut
shot charts at 18,0
ent ln     chart line 1000:42 1200:62 1300:73 1400:45 suffix " m" w 5.4 h 2.6 at -3.3,1.2
ent br     chart bars England:2 France:1.4 Italy:1.1 suffix "×" w 5.6 h 2.4 at -3.3,-2.4
ent dn     chart donut clergy:5 nobles:5 peasants:90 suffix "%" label "society" r 1.4 at 3.9,0.2
t6         cam charts
t6.2-t8    in ln stagger .35
t8-t9      in br stagger .2
t9-t10.5   in dn stagger .3
t10.8      highlight ln[2]

# ---- diagrams: a pyramid, a cycle, a flow with branches and words on its arrows
shot diag at 36,0
ent soc    pyramid "clergy" "nobles" "peasants" w 4.4 h 3.2 at -4.5,1.4
ent rot    cycle "wheat" "beans" "fallow" r 1.15 size 0.7 label "3 fields" at -4.5,-2.3
ent fl     flow "farm>market:sells grain>town*" "market>lord:rent" "town>guild" w 7.4 h 4.4 at 2.8,0
t12        cam diag
t12.2-t13.4 in soc stagger .35
t13.5-t14.8 in rot stagger .3
t15        in fl[0] pop
t15.5      in fl[1] fade
t16        in fl[2] fade
t16.4      in fl[3] fade
t16.8      in fl[4] fade
t17.2      ring fl.town

# ---- paper: a quote, a document with a seal, a title
shot paper at 54,0
ent ttl    title "the three orders" sub "part two" size 0.7 at -3.2,2.9
ent q      quote "Town air makes free." who "a medieval saying" w 6 at -3.0,0.2
ent charter doc "Charter of the town" sub "anno 1188" seal at 3.9,-0.4
t18        cam paper
t18.2      in ttl fade
t19        in q fade
t20        in charter drop
t21        stamp charter "free"

# ---- a picture's parts named, and the marks
shot marks at 0,-11
ent cath   photo "a gothic cathedral facade" size 4.2 at -3.2,0.3
ent cl     labels "spire@0.5,0.08" "rose window@0.5,0.4" "portal@0.5,0.85" "buttress@0.1,0.6" on cath
ent w1     text "money" size 0.4 at 3.2,2.6
ent w2     text "labour" size 0.4 at 3.2,1.5
ent w3     text "rent" size 0.4 at 3.2,0.4
ent ok     icon wheat badge green size 0.8 at 2.6,-1.2
ent no     icon swords badge navy size 0.8 at 4.6,-1.2
ent pile   dots 30 grid 10 shape user color ink at 3.4,-2.9
t23        cam marks
t23.2      in cath fade
t23.6-t25  in cl stagger .3
t25.2      in w1,w2,w3 fade
t25.6      highlight w1
t26        strike w2
t26.4      box w3
t26.8      in ok,no pop
t27        tick ok
t27.3      cross no
t27.6      callout ok "grows food" up
t28        in pile fade
t28.4      bracket w1,w2,w3 "the old ties"
t29        spotlight cath
t31        lift w1

# ---- lists and comparisons: compare, table, list, steps, stat
shot lists at 18,-11
ent cmp    compare "manor" "town" "labour:wages" "lord:guild" "serf:free" w 6.4 at -3.4,1.6
ent tbl    table "crop|season|for" "wheat, rye|autumn|people" "peas, beans|spring|people" "oats|spring|horses" size 0.2 at 3.4,1.9
ent lst    list "squares" "churches" "roads" "shops" numbered size 0.24 at -4.6,-2.3
ent stp    steps "plough" "sow" "harvest" w 5.6 at 0.6,-2.0
ent st     stat 0 "of Europe died" suffix "%" size 1.0 at 5.0,-2.1
t34        cam lists
t34.2-t35.5 in cmp stagger .3
t35.6-t36.6 in tbl stagger .2
t36.8-t37.8 in lst stagger .2
t37.8-t38.8 in stp stagger .3
t38.8      in st fade
t38.9-t40  count st 20
t40.1      strike cmp.labour
t40.3      tick cmp.wages

# ---- measures: calendar, meter, balance; fill, type
shot measure at 36,-11
ent cal    calendar 366 at -3.6,1.6
ent caln   label "a year and a day" size 0.14 at -3.6,-0.2
ent thermo meter 8 "summer heat" max 10 h 3 at -0.2,0.6
ent bal    balance "people" "food" w 3.6 at 3.9,0.8
ent barn   rect w 2.2 h 1.6 fill card line soft at -3.6,-2.4
ent word   text "town air makes free" size 0.32 at 2.6,-2.8
t41        cam measure
t41.2      in cal,caln fade
t41.5-t44  count cal 366
t41.6      in thermo fade
t42-t43.5  grow thermo 3
t42        in bal fade
t43.5-t44.5 tip bal left
t44.6      in barn fade
t44.8-t46  fill barn 70 gold
t45        type word

# ---- diagrams too: venn, tree, stack, waffle, formula
shot more at 54,-11
ent vn     venn "nobles" "merchants" label "wealth" r 1.25 at -4.4,1.6
ent tr     tree "king>lords>knights" "lords>clergy" "knights>serfs" w 4.0 h 3.8 at 0.2,1.0
ent stk    chart stack clergy:5 nobles:5 peasants:90 suffix "%" w 5.2 at -3.8,-2.2
ent wf     chart waffle died:20 lived:80 suffix "%" at 4.6,0.9
ent fx     formula "6CO_2 + 6H_2O -> C_6H_12O_6 + 6O_2" size 0.4 at 2.2,-2.8
t47        cam more
t47.2-t48.4 in vn stagger .3
t48.4-t49.6 in tr stagger .2
t49.6-t50.4 in stk stagger .2
t50.4-t51.2 in wf stagger .3
t51.4      in fx fade

# ---- the scene: backdrop, weather, a portrait, a bubble, pan, connect, follow, a map's compass and scale
shot scene at 0,-22
ent bg     backdrop "a snowy medieval forest at dusk"
ent snow   weather snow
ent kingp  portrait "Edward III" sub "1312 to 1377" img "commons:Edward III of England portrait" size 2.0 at -4.4,0.6
ent say    bubble "Bring back the old dues!" on kingp
ent mp     map "british isles" compass scale w 6.4 h 4.4 at 3.2,0.2
ent ship   icon ship size 0.5 color ink at mp.london
ent sea    path mp.london mp.calais dashed
t52        cam scene
t52.2      in bg fade
t52.4      in snow fade
t52.6      in kingp fade
t53        pan kingp zoom 1.08
t53.2      in say pop
t53.6      in mp fade
t54        in ship,sea fade
t54.5      connect kingp mp "rules"
t55-t57    along ship sea
t55-t57    follow ship zoom 2

# ---- science and maths: number line, plot, triangle, molecule, equation, circuit
shot science at 18,-22
ent nl     numberline -5 5 w 6 at -3.4,3.0
ent mark   icon map-pin size 0.45 color coral at nl.-2
ent pl     plot "x^2 - 2" -3 3 w 4.2 h 3.0 at -4.0,-0.6
ent dot    circle r 0.1 fill coral at pl.-3
ent tri    triangle A:0,0 B:3,0 C:0.8,2.2 sides angles at 0.9,-0.5
ent h2o    molecule H2O size 0.8 at 4.8,2.6
ent eq     equation "2x + 3 = 7" "2x = 4" "x = 2" size 0.3 at 4.8,0.5
ent ci     circuit "battery>bulb>switch" w 3.2 h 1.6 at 4.6,-2.6
t59        cam science
t59.2      in nl draw
t59.4      in mark pop
t59.6      move mark to nl.3
t60        in pl[0] fade
t60.3-t61.3 in pl[1] draw
t60.3      in dot pop
t60.4-t61.4 move dot to pl.2
t61.4-t62.4 in tri stagger .2
t62        in h2o stagger .1
t62.6-t63.6 in eq stagger .3
t63.6      highlight eq[2]
t63.8-t64.6 in ci stagger .15
t64.6      glow ci.bulb gold

# ---- data and civics: race, parliament, market, climate, scatter, area
shot civics at 36,-22
ent rc     race "1900|1950|2000" UK:12|8|5 USA:8|14|20 India:2|4|18 w 6 h 2.4 at -3.4,2.0
ent parl   parliament Gold:303 Teal:52 Coral:100 Navy:88 r 1.7 majority at -3.6,-1.8
ent mk     market w 3.6 h 2.6 at 1.5,1.2
ent cl     climate J:14:20 F:17:25 M:23:15 A:29:10 M:33:15 J:34:70 J:31:210 A:30:250 S:29:120 O:26:15 N:20:5 D:15:10 w 3.4 h 1.8 at 1.6,-2.3
ent sc     chart scatter 1:2 2:3 3:5 4:4 5:7 w 2.2 h 1.6 at 5.4,1.4
ent ar     chart area 1000:42 1300:73 1400:45 w 2.4 h 1.4 at 5.4,-2.0
t66        cam civics
t66.2      in rc fade
t66.4-t68.4 count rc 2000
t66.6      in parl stagger .2
t67        in mk stagger .2
t68-t69    grow mk 0.8
t68        in cl stagger .05
t68.5      in sc stagger .05
t69        in ar stagger .3

# ---- storytelling: quiz, lens, clock, odometer, clipping, split, who, polaroids
shot story at 54,-22
ent qz     quiz "Which came first?" "Jikji" "Gutenberg Bible" answer 1 w 6 at -3.4,1.9
ent wood   photo "a printing press woodcut" size 3.0 at -4.8,-2.0
ent ln     lens "@0.6,0.4" on wood zoom 3 r 0.8
ent clk    clock 9 r 0.8 at 1.0,2.6
ent od     odometer 0 digits 4 size 0.4 at 3.6,2.6
ent clip   clipping "Press reaches Venice" date "1469" w 3.0 h 2.1 at 0.6,-1.9
ent per    who "Johannes Gutenberg" sub "c. 1400 to 1468" where "Mainz" size 1.2 at 3.3,0.6
ent pol    polaroids "Mainz cathedral" "a medieval print shop" "a printed bible" size 1.0 at 4.6,-2.4
t71        cam story
t71.2      in qz[0] fade
t71.6      in qz[1] pop
t71.8      in qz[2] pop
t72.6      in qz[3] fade
t72.8      in wood fade
t73        in ln stagger .2
t73.2      in clk fade
t73.4-t74.4 count clk 17
t73.4      in od fade
t73.4-t75  count od 1455
t74        in clip drop
t74.4      in per fade
t74.8      in pol stagger .2

# ---- maps: era, shade, march, inset, globe, layers; a page turn
shot maps2 at 0,-33
ent em2    map "-10,34,40,60" year 1100 w 7.4 h 4.4 at -2.6,1.2
ent lit    shade "printed books, millions" on em2 France:30 Italy:45 Spain:12 Germany:40 England:8
ent ins    inset on em2
ent arm    march em2.paris em2.vienna em2.constantinople width 1.2
ent gl     globe 12,45 r 1.6 at 4.8,1.6
ent earth  layers "crust" "mantle" "outer core" "inner core" round r 1.4 at 4.8,-2.0
ent soil   layers "topsoil" "subsoil" "bedrock" w 3.6 h 1.8 at -2.6,-2.6
t76        cam maps2 via page
t77        in em2 fade
t77.4      in ins fade
t77.8      era em2 1500
t79.2      in lit stagger .1
t80-t81.2  in arm draw
t80        in gl fade
t80.6      in earth stagger .2
t81        in soil stagger .2
t82        cam scene via tear

# ---- the paper world: people who move, words that come on as they are said, a number counted as it is said,
# ---- cut-outs slapped down and peeled off (the default for them), a dive into the next shot, a chapter bar
shot folk at 18,-33
ent hdp    label "person · walk · point · talk · carry · sit · wave · phrase speak · slap · peel" size 0.18 at -4.8,3.4
ent ann    person wear coat hat top tool book mustache at -5,-2.9
ent ben    person wear apron hat straw hair curly seat face left mood surprised at 3.6,-2.9
ent purse  circle r 0.18 fill accent at -1.2,-2.2
ent kid    person wear dress hair ponytail-blonde kid at -6.2,-2.9
ent monk   person wear habit hat hood longbeard tool scroll mood calm at 6.2,-2.9
ent deal   card "a deal" at 4.2,1.6
ent spoken phrase "words come on as they are said" size 0.4 w 7 at -1.4,1.8
ent big    num 4800 size 0.8 suffix " books" at -1.4,0.3
t83        cam maps2 via whip
t84        chapter "People"
t84        cam folk via dive into em2.paris
t86        in hdp fade
t86.2      in ann
t86.4      in ben
t86.5      in kid,monk
t89.2-t90.8 think monk
t92.6-t93.3 jump kid
t86.6-t88.4 walk ann to -2.2,-2.9
t86.8-t88.6 in spoken speak
t88.6-t89.8 talk ben "a fair price?"
t89        point ann at ben
t89.6      in purse pop
t90-t90.8  carry ann purse
t90.8-t92.2 walk ann to 1.6,-2.9
t91        sit ben
t91.4      in deal
t92        cheer ann
t92.4      in big
t93.6      out deal

shot ends at 36,-33
ent hde    label "bring: a thing carried with the camera into the next shot" size 0.18 at -4.8,3.4
t95        chapter "Carried over"
t95-t96.4  cam ends
t95-t96.4  bring big to ends 0,0
t96.6      in hde fade

# ---- countries as characters, a framed map, more of what people do
shot powers at 54,-33
ent hdn    label "nation · faces · dance · faint · hug · a framed map" size 0.18 at -4.8,3.4
ent pr     nation Germany year 1900 color sky mood smug named size 3.0 at 3.0,-2.0
ent osz    nation Austria color coral mood nervous named size 2.0 at -1.6,-2.0
ent alb    nation Albania color green mood dazed named size 1.1 at -5.6,-2.6
ent atlas  map europe w 5.4 h 3.4 at -3.4,1.4
t97        cam powers
t97.4      in hdn fade
t97.6      in atlas fade
t98        in pr,osz,alb
t98.6-t99.6 point pr at osz
t98.8-t100.4 talk pr "SHHHHH"
t99.4-t101 shiver osz
t100-t101  faint alb
t101.2-t101.8 stand alb
t101.6-t102.8 hug osz pr
t102-t102.6 emote pr happy
