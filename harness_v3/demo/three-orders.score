# "When Fields Changed, Towns Grew" (The Three Orders): written by hand, as the score model should, for the
# narration in three-orders.txt (word numbers are the narration's own, so the cues hold on any machine).
look editorial

# ---- 1 cold: a field in a cold, forested Europe -------------------------------------------------------------------
shot cold at 0,0
ent head1   label "europe · 5th to 10th centuries" size 0.2 at -3.3,3.2
ent forest  photo "a dense dark pine forest in a cold medieval European winter with snow on the ground" size 6.2 at -2.2,0.2
ent field   pic "a small muddy ploughed field strip with furrows, seen from above" size 1.9 at -3.7,-1.25 layer 2
ent therm   icon thermometer-snowflake badge navy size 1.25 at 4.6,2.3
ent coldt   tag "intensely cold" size 0.32 at 4.6,1.15
ent snow    icon snowflake badge sky size 0.85 at 3.4,-0.2
ent glass   icon hourglass badge sand size 0.85 at 4.6,-0.2
ent crop    icon wheat badge gold size 0.85 at 5.8,-0.2
ent peas1   pic "a poor medieval peasant in a ragged brown tunic walking, full figure" size 2.1 at 4.9,-2.35

t0          cam cold
w3          in field pop
w5-w7       in forest rise
w9          in head1 fade
w20-w22     scale forest 1.06
w24-w27     shake field
w32         in therm pop
w33         in coldt pop
w34         in snow pop
w40         in glass pop
w42         in crop pop
w43         dim crop 0.3
w44         pulse forest
w50         in peas1 slide-left
w51-w53     move peas1 to -0.6,-1.2 arc .4
w53         dim peas1 0.55

# ---- 2 warm: temperatures rose, forests receded, more land was farmed --------------------------------------------
shot warm at 18,0
ent head2   label "from the 11th century" size 0.2 at -4.2,3.2
ent therm2  icon thermometer-sun badge coral size 1.3 at -4.9,1.6
ent tbar    bar 2 max 10 w 3.4 h 0.42 color coral at -4.9,0.25
ent tlab    label "temperature" size 0.12 at -4.9,-0.35
ent forl    label "forest" size 0.14 at -0.6,2.25
ent fbar    bar 7 max 10 w 6.2 h 0.5 color green at 2.3,1.75
ent farl    label "farmland" size 0.14 at -0.3,0.95
ent lbar    bar 3 max 10 w 6.2 h 0.5 color gold at 2.3,0.45
ent soil    photo "wide green ploughed farmland with long furrows in spring sunshine" size 4.0 at 2.6,-2.0

w54-w55     cam warm
w56         in head2 fade
w58         in therm2 pop
w58         in tbar,tlab fade
w59-w60     grow tbar 7.5
w62         pulse therm2
w70         in soil rise
w74         in forl,fbar,farl,lbar fade
w75-w76     grow fbar 4
w77-w83     grow lbar 6.5

# ---- 3 oldway: the wooden plough and the two-field system ---------------------------------------------------------
shot oldway at 36,0
ent head3   label "the old way · two fields" size 0.2 at -3.9,3.2
ent ard     pic "a simple medieval wooden scratch plough (ard) without wheels, side view" size 3.0 at -4.3,1.1
ent labour  tag "enormous labour" size 0.3 at -4.3,-0.8
ent fa      rect w 3.0 h 2.3 fill gold at 1.6,0.3
ent fb      rect w 3.0 h 2.3 fill sand at 4.9,0.3
ent fal     label "winter wheat" size 0.14 color ink at 1.6,0.3
ent fbl     label "fallow" size 0.14 color ink at 4.9,0.3
ent half    tag "half the land in use" size 0.3 at 3.25,2.3
ent rye     label "rye" size 0.14 color ink at 4.9,0.3
ent fal2    label "fallow" size 0.14 color ink at 1.6,0.3
ent famine  tag "famine was common" size 0.36 fill coral color white at 3.25,-2.2

w84-w85     cam oldway
w86         in head3 fade
w97         in ard pop
w100        shake ard
w108        in labour pop
w112        in fa,fb unfold stagger .2
w117        in half pop
w123-w127   in fal fade
w129-w132   in fbl fade
w136        out fal,fbl fade
w136-w137   color fb gold
w136-w137   color fa sand
w137        in rye,fal2 fade
w145        shake fa,fb
w148        dim fa,fb 0.45
w150        in famine pop

# ---- 4 pressure: lords push, peasants resist; shared land becomes private ---------------------------------------
shot pressure at 54,0
ent lord    card "lords" img "a medieval lord in a fur-trimmed cloak with a sword at his belt, full figure" at -3.6,0.9
ent folk    card "peasants" img "a small group of medieval peasants holding hoes and sickles" at 3.6,0.9
ent push    arrow lord folk curve -0.45 color coral
ent more1   tag "more land, more work" size 0.3 at 0,2.75
ent q4      tag "did peasants simply accept this?" size 0.38 at 0,-3.05
ent no      tag "no." size 0.7 fill coral color white at 0,-3.05
ent kept    icon wheat badge gold size 0.75 at 2.4,-1.45
ent avoid   icon ban badge navy size 0.75 at 3.6,-1.45
ent fight   icon swords badge coral size 0.75 at 4.8,-1.45
ent commons icon trees badge green size 1.15 at 0,-0.3
ent shared  label "shared by all" size 0.13 at 0,-1.15
ent priv    icon lock badge ink size 0.55 at 0.55,0.2 layer 3
ent privl   label "the lord's property" size 0.13 at 0,-1.15

w153-w154   cam pressure
w153        in lord drop
w158        in folk drop
w160        in push draw
w163-w165   in more1 pop
w171        in q4 pop
w177        out q4 fade
w177        in no pop
w180        in kept pop
w189        in avoid pop
w194        in fight pop
w196        in commons pop
w201-w202   in shared fade
w210        pulse lord
w214        out shared fade
w215        in priv pop
w215        in privl fade

# ---- 5 tools: new tools and methods ------------------------------------------------------------------------------
shot tools at 0,-11
ent head5   label "new tools · from the 11th century" size 0.2 at -3.3,3.2
ent c1      card "iron plough" img "a heavy medieval iron-tipped plough with a curved wooden mouldboard, side view" size 1.25 at -4.65,0.5
ent c2      card "shoulder harness" img "a draught horse wearing a padded shoulder collar harness, side view" size 1.25 at -1.55,0.5
ent c3      card "iron shoes" img "a single iron horseshoe with nail holes" size 1.25 at 1.55,0.5
ent c4      card "mills" img "a medieval stone watermill with a large wooden water wheel" size 1.25 at 4.65,0.5
ent bal     icon scale badge accent size 0.95 at 0,-2.9

w217-w218   cam tools
w219        in head5 fade
w230-w231   in bal pop
w231        shake bal
w233        in c1 drop
w239-w240   pulse c1
w246        in c2 drop
w256        in c3 drop
w262        in c4 drop
w264        pulse c4

# ---- 6 three: two fields become three, and the jobs rotate ------------------------------------------------------
shot three at 18,-11
ent head6   label "two fields become three" size 0.2 at -4.3,3.2
ent s1      rect w 3.6 h 2.2 fill gold at -4.0,0.6
ent s2      rect w 3.6 h 2.2 fill green at 0,0.6
ent s3      rect w 3.6 h 2.2 fill sand at 4.0,0.6
ent i1      icon wheat size 1.0 color ink at -4.0,0.6 layer 2
ent i2      icon bean size 1.0 color ink at 0,0.6 layer 2
ent i3      icon sprout size 1.0 color ink at 4.0,0.6 layer 2
ent lb1     label "autumn: wheat, rye" size 0.13 at -4.0,-0.95
ent lb2     label "spring: peas, beans, oats" size 0.13 at 0,-0.95
ent lb3     label "resting" size 0.13 at 4.0,-0.95
ent x2      num 1 prefix "×" size 0.8 at 0,-2.35
ent x2l     label "food from each unit of land" size 0.13 at 0,-3.3

w271-w272   cam three
w273        in head6 fade
w285-w289   in s1,s2,s3 unfold stagger .25
w291        in i1 pop
w292        in lb1 fade
w300        in i2 pop
w301        in lb2 fade
w316        in i3 pop
w317        in lb3 fade
w321-w327   move i1 to 0,0.6 arc .5
w321-w327   move lb1 to 0,-0.95
w321-w327   move i2 to 4.0,0.6 arc .5
w321-w327   move lb2 to 4.0,-0.95
w321-w327   move i3 to -4.0,0.6 arc -.5
w321-w327   move lb3 to -4.0,-0.95
w321-w327   color s1 sand
w321-w327   color s2 gold
w321-w327   color s3 green
w338        in x2,x2l pop
w343-w345   count x2 2

# ---- 7 farms: a better diet, smaller farms, mills and smithies -------------------------------------------------
shot farms at 36,-11
ent stew    pic "a wooden bowl of thick pea and bean stew" size 1.9 at -5.1,1.9
ent cow     pic "a brown cow eating a pile of hay" size 2.1 at -5.1,-0.6
ent fhead   label "the average farm" size 0.16 at -0.9,2.35
ent farm    bar 100 max 100 w 7.0 h 0.6 color green at 2.3,1.75
ent acres   num 100 suffix " acres" size 0.42 at 4.6,0.85
ent when    label "by the 13th century" size 0.13 at -0.6,0.85
ent time    icon hourglass badge gold size 0.85 at -0.9,-0.45
ent mill    pic "a medieval wooden windmill with four sails" size 2.3 at 1.2,-2.2
