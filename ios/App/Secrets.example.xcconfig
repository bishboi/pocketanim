// Copy to Secrets.xcconfig (gitignored) and fill in. Never commit real values.
//
// xcconfig treats "//" as the start of a comment, so the URL's "//" is written "/$()/" (an empty variable between
// the slashes); the app sees https://your-project-ref.supabase.co.
PANIM_SUPABASE_URL = https:/$()/your-project-ref.supabase.co
PANIM_SUPABASE_ANON_KEY = your-anon-key

// Your Apple developer team ID (Xcode: Settings -> Accounts), for running on a device.
// DEVELOPMENT_TEAM = ABCDE12345
