# The verbs, pictures and drifts the corpus programs do not reach, in one 2D program, for ios/scripts/crosscheck.sh.
# Its assets are dsl/generated's (the script links them in); its pictures are written by the script.
scene 2d fps=30 bg=#202830
geom G asset=12c7580a8e z=5
geom H asset=12c7580a8e z=6
text T asset=bc63561b3d z=10
text A asset=82118a6e9d
text B asset=98350e0205
text D asset=ea83059fb0
geom BG asset=6b4a370fa2 z=-50
circle C r=1.1 at=-3,1 stroke=#58C4DD w=6
square Q s=1.5 at=2,-1 stroke=#F7D96F w=4
rect R wh=3,1.2 at=0,2.5 stroke=#FC6255 w=3
circle K r=0.6 at=4,2 stroke=#83C167 w=5
square GHOST s=1 at=0,0 stroke=#FFFFFF w=2
drift BG period=20 amp=0.4 scale=0.03 turn=0.02
image P1 src=pic.png px=4,2 z=7 keys=0:0:-6,3,-2,3,-6,1;20:1:-6,3,-2,3,-6,1;70:1:-5,3.5,-1,3.5,-5,1.5;110:0:-5,3.5,-1,3.5,-5,1.5
image P2 src=pic.png px=4,2 z=-60 keys=10:0.8:1,-1,5,-1,1,-3 drift=24,0.3,0.02,0.01,0.4,3,-2
show BG
fade BG t=0.5
write T t=1.2
show T
create C t=1 rate=rush_into
show C
par n=3 t=1.5
stroke C color=#FF8800 w=9 opacity=0.6 t=1.5
fill C color=#3366FF opacity=0.5 t=1.5
rotate Q deg=90 at=2,-1 t=1.5 rate=linear
indicate C t=1
grow R t=0.8
grow K t=0.6 at=4,1
laggedgrow G lag=0.3 groups=10,10,8 t=1.5
show G
stroke G color=#FFFFFF w=2 t=0.7
fill G color=#00FF00 opacity=0.4 t=0.7
rotate G deg=-30 at=0,0 t=1 rate=ease_out_back
indicate G t=0.8
xform G by=0.6 by_xy=1,-1 t=1 rate=there_and_back
create H t=1.2 lag=0.5
show H
grow H t=0.6
lag runs=2,1,1 ratio=0.4 t=2
fade Q t=0.6 shift=0,-1 from=0.5 rate=ease_out_cubic
fadeout Q t=0.6 shift=0.5,0
fadeout K t=0.5 rate=ease_out_expo
fadeout GHOST t=0.4
transform C R t=1.2 arc=0.8 rate=double_smooth
wait t=0.3
write A t=1
show A
morph A B t=1 keep=1
morph A D t=1.2
show D
hide A
unwrite D t=1
uncreate R t=0.8 rate=slow_into
fadeout H t=0.6 shift=0,1 from=0.2 rate=ease_in_cubic
fade T t=0.3 rate=rush_from
fadeout T t=0.3 rate=there_and_back
wait t=1.5
