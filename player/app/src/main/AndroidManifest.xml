<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Saved lectures are listed, streamed and downloaded from the harness's Supabase project (SavedLectures). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="pocketanim"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <!-- The library: what there is to watch. -->
        <activity
            android:name=".LibraryActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- A lecture from the harness ("Download for the phone"), opened from the browser's downloads or a
                 file manager: imported (LibraryImport) and played. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
            </intent-filter>
        </activity>

        <!-- The player. It turns with the phone without restarting (it lays itself out again), so a lecture never
             stops or reloads on a rotation. -->
        <activity
            android:name=".PlayerActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:screenOrientation="unspecified" />
    </application>
</manifest>
